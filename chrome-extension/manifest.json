{
  "manifest_version": 3,
  "name": "Agentic Browser Bridge - AI Controller",
  "version": "1.4.0",
  "description": "Permanent Auto-Connect WebSocket & CDP Bridge allowing AI Agent Studio to control and manage browser tabs with custom AI cursor and dynamic idle auto-hide.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "storage",
    "cookies",
    "scripting",
    "webNavigation",
    "downloads",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chz.png",
        "config.json",
        "gemini_robot.png",
        "background.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Agent Browser Bridge"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
